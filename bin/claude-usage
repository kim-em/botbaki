#!/bin/bash
# Check Claude Max usage by launching a Claude session with /usage command
# Usage: claude-usage [--verbose]
#
# Returns JSON with usage information, suitable for tool use.

# Parse arguments
VERBOSE=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --verbose|-v)
            VERBOSE=true
            shift
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
done

# Cache file (5 minute TTL)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CACHE_FILE="$SCRIPT_DIR/.claude-usage-cache"
CACHE_TTL=300  # 5 minutes in seconds

# Check if cache is fresh (less than 5 minutes old)
if [ -f "$CACHE_FILE" ]; then
    CACHE_AGE=$(($(date +%s) - $(stat -f %m "$CACHE_FILE" 2>/dev/null || stat -c %Y "$CACHE_FILE" 2>/dev/null)))
    if [ "$CACHE_AGE" -lt "$CACHE_TTL" ]; then
        # Cache is fresh, return cached result
        if $VERBOSE; then
            CACHE_TIME=$(date -r "$CACHE_FILE" "+%Y-%m-%d %H:%M:%S")
            echo "  Using cached result from $CACHE_TIME" >&2
        fi
        cat "$CACHE_FILE"
        exit 0
    fi
fi

# Temp file for output
TMPFILE=$(mktemp)
trap "rm -f $TMPFILE" EXIT

# Create expect script that captures ALL output
expect << 'EOF' > "$TMPFILE" 2>&1
log_user 1
set timeout 30

spawn claude

# Wait for the UI to fully initialize
expect {
    "bypass permissions" {}
    "shift+tab" {}
    timeout {
        puts "ERROR: Timeout waiting for Claude"
        exit 1
    }
}

# Brief pause to let TUI settle
sleep 0.5

# Send /usage command and Enter together
# Then wait for either autocomplete to appear OR panel to open
send "/usage\r"

# Wait for autocomplete OR panel
expect {
    "Show plan usage limits" {
        # Autocomplete appeared - send another Enter to select
        sleep 0.2
        send "\r"
        exp_continue
    }
    "Esc to exit" {
        # Panel opened, now wait for data to load
    }
    "% used" {
        # Already have data
    }
    timeout {
        puts "ERROR: Timeout waiting for usage panel"
    }
}

# Wait for usage data - need to see multiple "% used" for all categories
# The TUI redraws the screen, so we need to wait for the full panel
set usage_count 0
expect {
    "% used" {
        incr usage_count
        if {$usage_count < 3} {
            exp_continue
        }
        # All three categories visible, brief pause for full render
        sleep 0.5
    }
    "Loading" {
        exp_continue
    }
    timeout {
        puts "ERROR: Timeout waiting for usage data"
    }
}

# Force kill the spawned process - don't wait for graceful exit
catch {exec kill -9 [exp_pid]}
catch {close}
catch {wait}
EOF

OUTPUT=$(cat "$TMPFILE")

# Debug: save raw output for inspection
cp "$TMPFILE" /tmp/claude-usage-debug.txt 2>/dev/null

# Strip ALL ANSI escape codes more thoroughly
# This handles: CSI sequences and simple escape codes
clean_output=$(echo "$OUTPUT" | \
    sed $'s/\x1b\\[[0-9;?]*[a-zA-Z]//g' | \
    sed $'s/\x1b[()][AB012]//g' | \
    tr -d '\r' | \
    tr -s ' ')

# Extract the usage information by section
# The TUI shows sections: "Current session", "Current week (all models)", "Current week (Sonnet only)"
# Each section has a percentage and reset time

# Extract percentages (allow optional space before "used" - TUI sometimes omits space)
session_pct=$(echo "$clean_output" | grep -o '[0-9]*% *used' | sed -n '1p' | grep -o '[0-9]*' || echo "")
week_all_pct=$(echo "$clean_output" | grep -o '[0-9]*% *used' | sed -n '2p' | grep -o '[0-9]*' || echo "")
week_sonnet_pct=$(echo "$clean_output" | grep -o '[0-9]*% *used' | sed -n '3p' | grep -o '[0-9]*' || echo "")

# Extract reset times - look for "Resets" followed by timezone in parens
# Format: "Resets Dec 16, 9:59am (Australia/Sydney)" or "Resets Dec 16, 10am (Australia/Sydney)"
# Time may or may not have minutes (e.g., "4pm" or "4:30pm")
# The session reset may be garbled (e.g., "Reses4pm") due to TUI artifacts

# Week resets have date format: "Resets Month Day, Time (Timezone)"
# Time format: [0-9]+ optionally followed by :[0-9]+ then am/pm
week_all_reset=$(echo "$clean_output" | grep -oE 'Resets [A-Z][a-z]+ [0-9]+, [0-9]+(:[0-9]+)?(am|pm) \([^)]+\)' | head -1 | sed 's/Resets //' || echo "")
week_sonnet_reset=$(echo "$clean_output" | grep -oE 'Resets [A-Z][a-z]+ [0-9]+, [0-9]+(:[0-9]+)?(am|pm) \([^)]+\)' | sed -n '2p' | sed 's/Resets //' || echo "")

# Session reset is simpler: just time (e.g., "4pm" or "4:30pm") - may be garbled
# Try to extract from the garbled "Reses4pm" or clean "Resets 4pm"
# Match anything that looks like time + timezone, then clean up the prefix
session_reset=$(echo "$clean_output" | grep -oE '[A-Za-z]*[0-9]+(:[0-9]+)?(am|pm) \([^)]+\)' | head -1 | sed 's/^[A-Za-z]*//' || echo "")

# Format percentage for JSON (number or null)
json_pct() {
    if [ -n "$1" ] && [ "$1" -eq "$1" ] 2>/dev/null; then
        echo "$1"
    else
        echo "null"
    fi
}

# Calculate time elapsed percentage through a window
# Args: $1 = reset time string, $2 = window duration in seconds
time_elapsed_pct() {
    local reset_str="$1"
    local window_secs="$2"

    if [ -z "$reset_str" ] || [ "$reset_str" = "unknown" ]; then
        echo "null"
        return
    fi

    # Get current time
    local now_epoch=$(date +%s)

    # Parse the reset time string
    # Formats: "1pm (Australia/Sydney)" or "Dec 2, 10am (Australia/Sydney)"

    # Extract timezone from parentheses
    local tz=$(echo "$reset_str" | grep -o '([^)]*' | tr -d '(')
    if [ -z "$tz" ]; then
        tz="Australia/Sydney"
    fi

    # Remove timezone part for parsing
    local time_part=$(echo "$reset_str" | sed 's/ *([^)]*)$//')

    # Check if it has a date component (contains a comma or month name at start)
    if echo "$time_part" | grep -q ','; then
        # Format: "Dec 2, 10am" or "Dec 2, 9:59am" -> need to insert year after day
        # Extract: month day, time -> month day year time
        local month_day=$(echo "$time_part" | sed 's/,.*//')
        local time_only=$(echo "$time_part" | sed 's/.*,[ ]*//' | sed 's/am/AM/;s/pm/PM/')
        local year=$(date +%Y)
        local full_str="$month_day $year $time_only"

        # Check if time has minutes (contains colon)
        if echo "$time_only" | grep -q ':'; then
            # Format with minutes: "Dec 2 2025 9:59AM"
            local reset_epoch=$(TZ="$tz" date -j -f "%b %d %Y %I:%M%p" "$full_str" +%s 2>/dev/null)
            if [ -z "$reset_epoch" ]; then
                reset_epoch=$(TZ="$tz" date -j -f "%b %d %Y %l:%M%p" "$full_str" +%s 2>/dev/null)
            fi
        else
            # Format without minutes: "Dec 2 2025 10AM"
            local reset_epoch=$(TZ="$tz" date -j -f "%b %d %Y %I%p" "$full_str" +%s 2>/dev/null)
            if [ -z "$reset_epoch" ]; then
                reset_epoch=$(TZ="$tz" date -j -f "%b %d %Y %l%p" "$full_str" +%s 2>/dev/null)
            fi
        fi
    else
        # Format: "1pm" or "12:59pm" - next occurrence of this time
        # If the time has already passed today, it means tomorrow
        local today=$(TZ="$tz" date +"%Y-%m-%d")
        local time_normalized=$(echo "$time_part" | sed 's/am/AM/;s/pm/PM/')

        # Check if time has minutes (contains colon)
        if echo "$time_normalized" | grep -q ':'; then
            # Format: "12:59PM"
            local reset_epoch=$(TZ="$tz" date -j -f "%Y-%m-%d %I:%M%p" "$today $time_normalized" +%s 2>/dev/null)
            if [ -z "$reset_epoch" ]; then
                reset_epoch=$(TZ="$tz" date -j -f "%Y-%m-%d %l:%M%p" "$today $time_normalized" +%s 2>/dev/null)
            fi
        else
            # Format: "1PM"
            local reset_epoch=$(TZ="$tz" date -j -f "%Y-%m-%d %I%p" "$today $time_normalized" +%s 2>/dev/null)
            if [ -z "$reset_epoch" ]; then
                reset_epoch=$(TZ="$tz" date -j -f "%Y-%m-%d %l%p" "$today $time_normalized" +%s 2>/dev/null)
            fi
        fi

        # If the reset time is in the past, it means tomorrow
        if [ -n "$reset_epoch" ] && [ "$reset_epoch" -lt "$now_epoch" ]; then
            reset_epoch=$((reset_epoch + 86400))  # Add 24 hours
        fi
    fi

    if [ -z "$reset_epoch" ] || [ "$reset_epoch" -eq 0 ] 2>/dev/null; then
        echo "null"
        return
    fi

    # Calculate elapsed time since window started
    # Window started at (reset_time - window_duration)
    local start_epoch=$((reset_epoch - window_secs))
    local elapsed=$((now_epoch - start_epoch))

    # Calculate percentage (0-100)
    if [ $elapsed -lt 0 ]; then
        echo 0
    elif [ $elapsed -gt $window_secs ]; then
        echo 100
    else
        echo $((elapsed * 100 / window_secs))
    fi
}

# Window durations in seconds
SESSION_WINDOW=$((5 * 60 * 60))        # 5 hours
WEEK_WINDOW=$((7 * 24 * 60 * 60))      # 7 days

# Calculate time elapsed for each window
session_time_pct=$(time_elapsed_pct "$session_reset" $SESSION_WINDOW)
week_all_time_pct=$(time_elapsed_pct "$week_all_reset" $WEEK_WINDOW)
week_sonnet_time_pct=$(time_elapsed_pct "$week_sonnet_reset" $WEEK_WINDOW)

# Output as JSON
OUTPUT=$(cat << ENDJSON
{
  "session": {
    "percent_used": $(json_pct "$session_pct"),
    "percent_time_elapsed": $session_time_pct,
    "resets": "${session_reset:-unknown}"
  },
  "week_all_models": {
    "percent_used": $(json_pct "$week_all_pct"),
    "percent_time_elapsed": $week_all_time_pct,
    "resets": "${week_all_reset:-unknown}"
  },
  "week_sonnet_only": {
    "percent_used": $(json_pct "$week_sonnet_pct"),
    "percent_time_elapsed": $week_sonnet_time_pct,
    "resets": "${week_sonnet_reset:-unknown}"
  }
}
ENDJSON
)

# Cache the result
echo "$OUTPUT" > "$CACHE_FILE"

# Output to stdout
echo "$OUTPUT"
