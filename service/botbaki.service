[Unit]
Description=Botbaki GitHub PR Review Bot
After=network.target

[Service]
Type=simple
User=kim
WorkingDirectory=/home/kim/projects/botbaki
ExecStart=/home/kim/projects/botbaki/.venv/bin/python3 -m src.cli daemon
Restart=always
RestartSec=30

# Environment - load from file for secrets
EnvironmentFile=/home/kim/.config/botbaki/env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=botbaki

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/kim/projects/botbaki/data
ReadOnlyPaths=/home/kim/.config/botbaki

[Install]
WantedBy=multi-user.target
